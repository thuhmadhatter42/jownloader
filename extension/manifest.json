{
  "manifest_version": 3,
  "name": "Jownloader",
  "version": "0.1.34",
  "description": "Download every image, video or document on the current page, best quality, into any folder. ⬇ button on every video, collect-as-you-scroll, popup or sidebar.",
  "permissions": [
    "nativeMessaging",
    "notifications",
    "sidePanel",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jownloader",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "content.js"
      ]
    }
  ],
  "key": ""
}